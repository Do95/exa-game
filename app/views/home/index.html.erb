<%= turbo_stream_from "leaderboard" %>
<div class="home">
  <section class="hero">
    <div class="kicker">The Simple Past challenge</div>
    <h1 class="big">Flash<em>back</em></h1>
    <p class="lead">Travel back in time and prove you know the Simple Past. Play on your own, or join your class in a live game. Fast answers score more.</p>
  </section>

  <div class="modes">
    <section class="mode-card">
      <div class="mode-head"><span class="mode-ico ico-solo" aria-hidden="true"></span><div><h2>Play solo</h2><p>Practice at your own pace.</p></div></div>
      <%= form_with url: solo_index_path, class: "stack" do %>
        <label class="field"><span class="label">Your name</span><%= text_field_tag :name, nil, maxlength: 22, required: true, placeholder: "Type your name", autocomplete: "off" %></label>
        <div class="field">
          <span class="label">Questions</span>
          <div class="seg">
            <% [5, 10, 15, 20].each do |n| %>
              <label><%= radio_button_tag :count, n, n == 10 %><span><%= n %></span></label>
            <% end %>
          </div>
        </div>
        <details class="more">
          <summary>Choose challenge types</summary>
          <%= render "shared/kinds", prefix: "solo" %>
        </details>
        <%= submit_tag "Start playing", class: "btn", data: { turbo_submits_with: "Starting…" } %>
      <% end %>
    </section>

    <section class="mode-card">
      <div class="mode-head"><span class="mode-ico ico-live" aria-hidden="true"></span><div><h2>Join a live game</h2><p>Your teacher shows the code on the board.</p></div></div>
      <%= form_with url: join_path, class: "stack" do %>
        <label class="field"><span class="label">Game code</span><%= text_field_tag :code, nil, maxlength: 6, required: true, placeholder: "123456", class: "code-input", autocomplete: "off", inputmode: "numeric", pattern: "[0-9]{6}" %></label>
        <label class="field"><span class="label">Your name</span><%= text_field_tag :name, nil, maxlength: 22, required: true, placeholder: "Type your name", autocomplete: "off" %></label>
        <%= submit_tag "Join the game", class: "btn btn-red", data: { turbo_submits_with: "Joining…" } %>
      <% end %>
      <p class="note">Teacher? <%= link_to "Host a live game", new_host_path %></p>
    </section>
  </div>

  <section class="side-board">
    <div class="lbhead"><h3 class="label"><span class="live"></span>Today's top players</h3><%= link_to "All scores", scores_path, class: "linkish" %></div>
    <%= render "shared/leaderboard", participants: @top, show_mode: true %>
    <p class="note"><%= @question_count %> questions in the bank.</p>
  </section>
</div>
