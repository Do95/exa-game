<%= form_with model: [:admin, question], class: "stack qform" do |f| %>
  <% if question.errors.any? %>
    <div class="flash flash-alert"><%= question.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="grid-2">
    <label class="field"><span class="label">Type</span>
      <%= f.select :kind, Question::KINDS.map { |k, v| [v[:label], k] } %>
    </label>
    <label class="field"><span class="label">Time limit (seconds)</span>
      <%= f.number_field :time_limit, min: 5, max: 90 %>
    </label>
  </div>
  <label class="field"><span class="label">Question</span>
    <%= f.text_field :prompt, required: true, maxlength: 200, placeholder: "go · Last night, I ____ a movie. · Which sentence is correct?" %>
    <small class="muted">For "Fill the gap", write ____ (four underscores) where the verb goes.</small>
  </label>
  <label class="field"><span class="label">Hint (optional)</span>
    <%= f.text_field :hint, maxlength: 40, placeholder: "watch" %>
    <small class="muted">Shown in brackets after a "Fill the gap" sentence, like (watch).</small>
  </label>
  <div class="grid-2">
    <label class="field"><span class="label">Answers, one per line (2 to 4)</span>
      <%= f.text_area :options_text, rows: 4, required: true %>
    </label>
    <label class="field"><span class="label">Number of the correct answer</span>
      <%= f.number_field :correct_number, min: 1, max: 4, required: true %>
      <small class="muted">1 is the first line, 2 the second, and so on.</small>
    </label>
  </div>
  <label class="field"><span class="label">Explanation (shown after answering)</span>
    <%= f.text_area :explanation, rows: 2, placeholder: "go is irregular: went." %>
  </label>
  <label class="check"><%= f.check_box :active %> <span>Active (can appear in games)</span></label>
  <div class="row">
    <%= f.submit "Save question", class: "btn" %>
    <%= link_to "Cancel", admin_questions_path(kind: question.kind), class: "btn btn-alt" %>
  </div>
<% end %>
